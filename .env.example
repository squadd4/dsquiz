# Supabase Configuration
# Obtenha estes valores no dashboard do Supabase: Project Settings -> API

# URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Chave secreta de serviço (recomendado para a Serverless Function no Vercel)
# Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Em alternativa, pode usar a chave pública anon:
# SUPABASE_ANON_KEY=your-supabase-anon-key
